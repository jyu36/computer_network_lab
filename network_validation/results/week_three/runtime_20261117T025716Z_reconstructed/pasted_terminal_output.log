jyu164@sdnlabjy:~/sdn-project/computer_network_lab$ cd ~/sdn-project/computer_network_lab
git pull --ff-only

batch_directory="$PWD/network_validation/results/week_three/runtime_$(date -u +%Y%m%dT%H%M%SZ)"

if sudo install -d -o "$(id -un)" -g "$(id -gn)" "$batch_directory"; then
  for attempt in 01 02 05; do
    echo "Testing runtime version: Attempt $attempt"

    sudo /usr/bin/python3 network_validation/run_network_tests.py \
      --controller "week_three/PASS_attempt_${attempt}/runtime/controller.py" \
      --suite full \
      --ryu-manager "$HOME/sdn-project/.venv/bin/ryu-manager" \
      --results-directory "$batch_directory/attempt_${attempt}" \
      --verbose \
      2>&1 | tee "$batch_directory/attempt_${attempt}.terminal.log"

    pipeline_status=("${PIPESTATUS[@]}")
    result=${pipeline_status[0]}
    log_result=${pipeline_status[1]}

    echo "Attempt $attempt: test exit code $result; log exit code $log_result" \
      | tee -a "$batch_directory/batch_summary.txt"

    if [ "$result" -gt 1 ] || [ "$log_result" -ne 0 ]; then
      echo "Execution or logging error — stopping for investigation."
      break
    fi
  done

  sudo chown -R "$(id -un):$(id -gn)" "$batch_directory"
  echo "Results saved in: $batch_directory"
fi
