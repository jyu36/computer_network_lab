/usr/bin/python3 - <<'PY'
import json
from pathlib import Path

batch = Path("network_validation/results/week_three/20261116T214645Z")

for attempt in ("03", "04", "06"):
    print(f"\n===== ATTEMPT {attempt} =====")

    results = sorted((batch / f"attempt_{attempt}").rglob("result.json"))
    if not results:
        print("No result.json found.")
        continue

    for path in results:
        result = json.loads(path.read_text())
        if result.get("status") not in ("FAIL", "ERROR"):
            continue

        print("\nCASE DIRECTORY:", path.parent)
        print("RESULT:")
        print(json.dumps(result, indent=2))

        events_path = path.parent / "events.json"
        if events_path.exists():
            events = json.loads(events_path.read_text())
            statuses = [
                event for event in events
                if event.get("method") == "GET"
                and event.get("path") == "status"
            ]
            print("\nLAST STATUS RESPONSES:")
            print(json.dumps(statuses[-3:], indent=2))

        log = path.parent / "controller.log"
        if log.exists():
            print("\nLAST 30 CONTROLLER LOG LINES:")
            print("\n".join(
                log.read_text(errors="replace").splitlines()[-30:]
            ))
PY

