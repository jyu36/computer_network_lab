jyu164@sdnlabjy:~/sdn-project/computer_network_lab$ cd ~/sdn-project/computer_network_lab
git pull --ff-only

batch_directory="$PWD/network_validation/results/week_three/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$batch_directory"

for attempt in 01 02 03 04 05 06; do
  echo "Testing Attempt $attempt"

  sudo /usr/bin/python3 network_validation/run_network_tests.py \
    --controller "week_three/attempt_${attempt}/controller.py" \
    --suite base \
    --ryu-manager "$HOME/sdn-project/.venv/bin/ryu-manager" \
    --results-directory "$batch_directory/attempt_${attempt}" \
    --verbose \
    2>&1 | tee "$batch_directory/attempt_${attempt}.terminal.log"

  result=${PIPESTATUS[0]}

  echo "Attempt $attempt: exit code $result" \
    | tee -a "$batch_directory/batch_summary.txt"

  if [ "$result" -gt 1 ]; then
    echo "Execution error — stopping for investigation." \
      | tee -a "$batch_directory/batch_summary.txt"
    break
  fi
done

echo "Results saved in: $batch_directory"
